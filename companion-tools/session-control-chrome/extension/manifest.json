{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Session Control · Claude Code",
  "version": "0.5.0",
  "description": "Organize Claude Code cloud sessions in a full-tab dashboard. Open each account in an isolated Mac Chrome profile.",
  "permissions": ["storage", "nativeMessaging", "activeTab", "scripting", "contextMenus"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "Open Session Control" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "open-dashboard": { "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" }, "description": "Open Session Control" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none';" }
}
