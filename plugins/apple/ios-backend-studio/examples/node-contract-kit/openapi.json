{
  "openapi": "3.1.0",
  "info": {
    "title": "Local iOS/Node Contract Kit",
    "version": "1.0.0",
    "description": "In-memory contract demonstration only. The factory denies protected routes unless a real authentication adapter is injected. The adapter must enforce the declared session scheme; synthetic test authority is not production authentication. No durable transaction, restart safety or production service is provided."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "Opt-in loopback demonstration. Production clients/services must use their real secure endpoint."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is listening. This is not readiness of a database/auth provider.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/items": {
      "post": {
        "operationId": "createItem",
        "description": "A verified account plus idempotency key identifies one operation. Same key/different validated title conflicts. Text is preserved without trim, normalization or truncation.",
        "security": [
          {
            "applicationSession": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "At most4096 UTF-8 bytes by default; no unknown JSON fields. Runtime also rejects invalid UTF-8 and unpaired surrogate escapes.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateItem"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created item or replay of its original same-account/same-payload receipt.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              },
              "Idempotency-Replayed": {
                "description": "Example-specific replay indicator.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "400": {
            "description": "Application error. Native HTTP parser/transport failures can occur before the application handler.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          },
          "401": {
            "description": "Application error. Native HTTP parser/transport failures can occur before the application handler.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          },
          "408": {
            "description": "Application error. Native HTTP parser/transport failures can occur before the application handler.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          },
          "409": {
            "description": "Application error. Native HTTP parser/transport failures can occur before the application handler.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          },
          "413": {
            "description": "Application error. Native HTTP parser/transport failures can occur before the application handler.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          },
          "415": {
            "description": "Application error. Native HTTP parser/transport failures can occur before the application handler.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          },
          "422": {
            "description": "Application error. Native HTTP parser/transport failures can occur before the application handler.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          },
          "500": {
            "description": "Application error. Native HTTP parser/transport failures can occur before the application handler.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
