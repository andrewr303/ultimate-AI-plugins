{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:studio-contracts:1.0.0:render-job",
  "title": "Render Job",
  "description": "Executable renderer job. Input paths are relative to the job project. A post-render report binds computed source/config hashes to outputs.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "renderer": {
      "enum": [
        "html-playwright",
        "footage",
        "remotion",
        "hyperframes"
      ]
    },
    "productRevision": {
      "type": "string",
      "minLength": 1
    },
    "visualMode": {
      "enum": [
        "faithful-replay",
        "recorded",
        "illustrative"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 48
    },
    "height": {
      "type": "integer",
      "minimum": 48
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "hook": {
      "type": "string",
      "minLength": 1
    },
    "promise": {
      "type": "string",
      "minLength": 1
    },
    "cta": {
      "type": "string",
      "minLength": 1
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        }
      },
      "required": [
        "name",
        "background",
        "ink",
        "accent"
      ],
      "additionalProperties": false
    },
    "claimIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "start",
          "end",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative forward-slash project path"
          },
          "role": {
            "enum": [
              "music",
              "narration",
              "sfx"
            ]
          },
          "gainDb": {
            "type": "number",
            "minimum": -60,
            "maximum": 18
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rightsId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "role",
          "gainDb",
          "start",
          "rightsId"
        ],
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative forward-slash project path"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "audioPolicy": {
          "enum": [
            "preserve",
            "mute"
          ]
        },
        "crop": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "minItems": 4,
          "maxItems": 4,
          "items": false
        }
      },
      "required": [
        "path",
        "start"
      ],
      "additionalProperties": false
    },
    "template": {
      "type": "string",
      "minLength": 1,
      "description": "Relative forward-slash project path"
    },
    "sourceHashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "configHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "campaignId": {
      "type": "string",
      "minLength": 1
    },
    "safeZone": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path to canonical product-evidence.json; default is product-evidence.json beside the job project."
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "placement": {
      "type": "string",
      "minLength": 1
    },
    "crf": {
      "type": "integer",
      "minimum": 12,
      "maximum": 32
    },
    "font": {
      "type": "string",
      "minLength": 1,
      "description": "Relative forward-slash project path"
    },
    "remotion": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "description": "Relative forward-slash project path"
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "description": "Relative forward-slash project path"
        },
        "composition": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project",
        "entry",
        "composition"
      ],
      "additionalProperties": false
    },
    "hyperframes": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "renderer",
    "productRevision",
    "visualMode",
    "width",
    "height",
    "fps",
    "duration",
    "hook",
    "promise",
    "cta",
    "brand",
    "claimIds",
    "captions",
    "audio"
  ],
  "additionalProperties": false
}
