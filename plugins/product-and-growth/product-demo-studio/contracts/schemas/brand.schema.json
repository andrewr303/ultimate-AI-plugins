{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:studio-contracts:1.0.0:brand",
  "title": "Brand",
  "description": "Versioned local production interchange. Validate with the bundled validator; schema identifiers do not require network access.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$",
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "productRevision": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "voice": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "colors": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "typography": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "heading",
        "body",
        "fallback"
      ],
      "additionalProperties": false
    },
    "logoPath": {
      "type": "string",
      "minLength": 1,
      "description": "Portable forward-slash path relative to the production project. No absolute paths, drive letters, parent traversal, or URLs."
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "repository",
            "capture",
            "documentation",
            "website",
            "user-supplied"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Portable forward-slash path relative to the production project. No absolute paths, drive letters, parent traversal, or URLs."
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "productRevision",
    "audience",
    "voice",
    "colors",
    "typography",
    "source",
    "synthetic"
  ],
  "additionalProperties": false
}
