{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:studio-contracts:1.0.0:capture-manifest",
  "title": "Capture Manifest",
  "description": "Versioned local production interchange. Validate with the bundled validator; schema identifiers do not require network access.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$",
      "maxLength": 100
    },
    "productRevision": {
      "type": "string",
      "minLength": 1
    },
    "captureJobId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$",
      "maxLength": 100
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$",
            "maxLength": 100
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Portable forward-slash path relative to the production project. No absolute paths, drive letters, parent traversal, or URLs."
          },
          "kind": {
            "enum": [
              "image",
              "video",
              "audio",
              "font",
              "source"
            ]
          },
          "mode": {
            "enum": [
              "actual",
              "replay",
              "illustrative"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "source": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "repository",
                  "capture",
                  "documentation",
                  "website",
                  "user-supplied"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Portable forward-slash path relative to the production project. No absolute paths, drive letters, parent traversal, or URLs."
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "rightsId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$",
            "maxLength": 100,
            "description": "ID of the owning asset-manifest.json document. Select the per-asset rights record by this capture asset id and require matching path/SHA-256."
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]*$",
              "maxLength": 100
            },
            "minItems": 0
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "path",
          "kind",
          "mode",
          "sha256",
          "source",
          "rightsId",
          "claims"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "productRevision",
    "captureJobId",
    "assets"
  ],
  "additionalProperties": false
}
