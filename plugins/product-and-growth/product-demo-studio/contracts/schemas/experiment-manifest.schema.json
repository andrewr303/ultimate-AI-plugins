{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:studio-contracts:1.0.0:experiment-manifest",
  "title": "Experiment Manifest",
  "description": "Versioned local production interchange. Validate with the bundled validator; schema identifiers do not require network access.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$",
      "maxLength": 100
    },
    "productRevision": {
      "type": "string",
      "minLength": 1
    },
    "campaignId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$",
      "maxLength": 100
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$",
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "angle": {
            "type": "string",
            "minLength": 1
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text",
          "angle",
          "hypothesis"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "bodies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$",
            "maxLength": 100
          },
          "approach": {
            "type": "string",
            "minLength": 1
          },
          "proof": {
            "type": "string",
            "minLength": 1
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]*$",
              "maxLength": 100
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "approach",
          "proof",
          "claims"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$",
            "maxLength": 100
          },
          "hookId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$",
            "maxLength": 100
          },
          "bodyId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$",
            "maxLength": 100
          },
          "aspectRatio": {
            "enum": [
              "9:16",
              "1:1",
              "4:5",
              "16:9"
            ]
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "awareness": {
            "type": "string",
            "minLength": 1
          },
          "painOrOutcome": {
            "type": "string",
            "minLength": 1
          },
          "offer": {
            "type": "string",
            "minLength": 1
          },
          "cta": {
            "type": "string",
            "minLength": 1
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "placement": {
            "type": "string",
            "minLength": 1
          },
          "variableTested": {
            "enum": [
              "hook",
              "body",
              "cta",
              "audience",
              "duration",
              "placement"
            ]
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "planned",
              "preview",
              "rendered",
              "reviewed",
              "delivered"
            ]
          },
          "renderPath": {
            "type": "string",
            "minLength": 1,
            "description": "Portable forward-slash path relative to the production project. No absolute paths, drive letters, parent traversal, or URLs."
          }
        },
        "required": [
          "id",
          "hookId",
          "bodyId",
          "aspectRatio",
          "audience",
          "awareness",
          "painOrOutcome",
          "cta",
          "duration",
          "placement",
          "variableTested",
          "hypothesis",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 36
    },
    "previewFirst": {
      "const": true
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "productRevision",
    "campaignId",
    "hooks",
    "bodies",
    "experiments",
    "previewFirst"
  ],
  "additionalProperties": false
}
