      "tool": {
        "driver": {
          "name": "seo-geo-god",
          "rules": [
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Start llms.txt with an H1 title and use H2 sections with Markdown link lists."
              },
              "helpUri": "https://llmstxt.org/",
              "id": "AGENT002",
              "name": "llms.txt structure invalid (e.g., no H1)",
              "properties": {
                "category": "ai_access",
                "evidenceClass": "B",
                "priority": "P3",
                "tags": [
                  "geo",
                  "ai_access"
                ]
              },
              "shortDescription": {
                "text": "llms.txt structure invalid (e.g., no H1)"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Use absolute URLs in llms.txt that exist on the site."
              },
              "helpUri": "https://llmstxt.org/",
              "id": "AGENT003",
              "name": "llms.txt link relative, malformed or missing from site",
              "properties": {
                "category": "ai_access",
                "evidenceClass": "B",
                "priority": "P3",
                "tags": [
                  "geo",
                  "ai_access"
                ]
              },
              "shortDescription": {
                "text": "llms.txt link relative, malformed or missing from site"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Publish the declared Markdown alternate or remove the rel=alternate link."
              },
              "helpUri": "https://llmstxt.org/",
              "id": "AGENT005",
              "name": "Markdown alternate declared but target missing",
              "properties": {
                "category": "ai_access",
                "evidenceClass": "B",
                "priority": "P2",
                "tags": [
                  "geo",
                  "ai_access"
                ]
              },
              "shortDescription": {
                "text": "Markdown alternate declared but target missing"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Confirm with the owner that leaving that AI search product is intended; allow the indexer token to stay eligible."
              },
              "helpUri": "https://developers.openai.com/api/docs/bots",
              "id": "AI001",
              "name": "AI search/answer indexer blocked by a named group (visibility impact)",
              "properties": {
                "category": "ai_access",
                "evidenceClass": "A",
                "priority": "P1",
                "tags": [
                  "geo",
                  "ai_access"
                ]
              },
              "shortDescription": {
                "text": "AI search/answer indexer blocked by a named group (visibility impact)"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "No change needed if the training opt-out is intended; this block does not remove the site from search."
              },
              "helpUri": "https://developers.openai.com/api/docs/bots",
              "id": "AI002",
              "name": "Training-only crawler blocked (no search impact)",
              "properties": {
                "category": "ai_access",
                "evidenceClass": "A",
                "priority": "P3",
                "tags": [
                  "geo",
                  "ai_access"
                ]
              },
              "shortDescription": {
                "text": "Training-only crawler blocked (no search impact)"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Unblock Googlebot and Bingbot; express AI-training choices with Google-Extended or Bingbot directives instead."
              },
              "helpUri": "https://developers.google.com/search/docs/crawling-indexing/robots/robots_txt",
              "id": "AI004",
              "name": "Googlebot or Bingbot blocked (removes Search and AI features)",
              "properties": {
                "category": "ai_access",
                "evidenceClass": "A",
                "priority": "P0",
                "tags": [
                  "geo",
                  "ai_access"
                ]
              },
              "shortDescription": {
                "text": "Googlebot or Bingbot blocked (removes Search and AI features)"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Write Content-Signal as comma-separated key=yes or key=no pairs using search, ai-input and ai-train."
              },
              "helpUri": "https://blog.cloudflare.com/content-signals-policy/",
              "id": "AI005",
              "name": "Malformed Content-Signal or unknown key",
              "properties": {
                "category": "ai_access",
                "evidenceClass": "B",
                "priority": "P2",
                "tags": [
                  "geo",
                  "ai_access"
                ]
              },
              "shortDescription": {
                "text": "Malformed Content-Signal or unknown key"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "Use Google-Extended and Bingbot ai-training or ai-grounding directives instead; Bing stops reading these as AI signals on 2027-03-01."
              },
              "helpUri": "https://developers.google.com/search/docs/crawling-indexing/robots-meta-tag",
              "id": "AI011",
              "name": "noarchive/nocache used as AI control (Google ignores; Bing until 2027-03-01)",
              "properties": {
                "category": "ai_access",
                "evidenceClass": "A",
                "priority": "P2",
                "tags": [
                  "geo",
                  "ai_access"
                ]
              },
              "shortDescription": {
                "text": "noarchive/nocache used as AI control (Google ignores; Bing until 2027-03-01)"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Add one absolute, self-referencing rel=canonical link in the page head."
              },
              "helpUri": "https://developers.google.com/search/docs/crawling-indexing/consolidate-duplicate-urls",
              "id": "CANON001",
              "name": "Missing canonical link",
              "properties": {
                "category": "crawl_index",
                "evidenceClass": "A",
                "priority": "P2",
                "tags": [
                  "seo",
                  "crawl_index"
                ]
              },
              "shortDescription": {
                "text": "Missing canonical link"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Emit a single absolute rel=canonical from one place in the layout."
              },
              "helpUri": "https://developers.google.com/search/docs/crawling-indexing/consolidate-duplicate-urls",
              "id": "CANON002",
              "name": "Multiple canonical links",
              "properties": {
                "category": "crawl_index",
                "evidenceClass": "A",
                "priority": "P1",
                "tags": [
                  "seo",
                  "crawl_index"
                ]
              },
              "shortDescription": {
                "text": "Multiple canonical links"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Use an absolute http(s) canonical URL without credentials, spaces or fragments."
              },
              "helpUri": "https://developers.google.com/search/docs/crawling-indexing/consolidate-duplicate-urls",
              "id": "CANON003",
              "name": "Canonical relative, malformed, non-http(s) or with credentials",
              "properties": {
                "category": "crawl_index",
                "evidenceClass": "A",
                "priority": "P1",
                "tags": [
                  "seo",
                  "crawl_index"
                ]
              },
              "shortDescription": {
                "text": "Canonical relative, malformed, non-http(s) or with credentials"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Point the canonical at a live, indexable URL that returns 200 without redirecting."
              },
              "helpUri": "https://developers.google.com/search/docs/crawling-indexing/consolidate-duplicate-urls",
              "id": "CANON004",
              "name": "Canonical target missing, noindex, redirecting or non-200 in the site",
              "properties": {
                "category": "crawl_index",
                "evidenceClass": "A",
                "priority": "P1",
                "tags": [
                  "seo",
                  "crawl_index"
                ]
              },
              "shortDescription": {
                "text": "Canonical target missing, noindex, redirecting or non-200 in the site"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "Confirm the page duplicates the canonical target; otherwise make the canonical self-referencing."
              },
              "helpUri": "https://developers.google.com/search/docs/crawling-indexing/consolidate-duplicate-urls",
              "id": "CANON005",
              "name": "Canonical points to a different URL",
              "properties": {
                "category": "crawl_index",
                "evidenceClass": "A",
                "priority": "P2",
                "tags": [
                  "seo",
                  "crawl_index"
                ]
              },
              "shortDescription": {
                "text": "Canonical points to a different URL"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Give each paginated page its own self-referencing canonical."
              },
              "helpUri": "https://developers.google.com/search/docs/specialty/ecommerce/pagination-and-incremental-page-loading",
              "id": "CANON006",
              "name": "Paginated page canonicalizes to page 1",
              "properties": {
                "category": "crawl_index",
                "evidenceClass": "A",
                "priority": "P1",
                "tags": [
                  "seo",
                  "crawl_index"
                ]
              },
              "shortDescription": {
                "text": "Paginated page canonicalizes to page 1"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Canonicalize each language version to itself or a same-language URL, never to another language."
              },
              "helpUri": "https://developers.google.com/search/docs/specialty/international/localized-versions",
              "id": "CANON007",
              "name": "Canonical crosses languages inside an hreflang cluster",
