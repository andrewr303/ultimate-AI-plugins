                "evidenceClass": "A",
                "priority": "P1",
                "tags": [
                  "seo",
                  "crawl_index"
                ]
              },
              "shortDescription": {
                "text": "Canonical crosses languages inside an hreflang cluster"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "Check which slash form the host serves and redirects to, then make the canonical match the served URL."
              },
              "helpUri": "https://developers.google.com/search/docs/crawling-indexing/consolidate-duplicate-urls",
