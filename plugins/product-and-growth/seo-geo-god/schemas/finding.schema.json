{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEO-GEO-god finding",
  "description": "One issue instance emitted by the seo-geo-god CLI. Identical shape in JSON envelopes, SARIF result properties and Markdown rows. Catalog fields (title, category, evidence_class, fix_hint, refs) come from data/rules.json.",
  "as_of": "2026-11-01",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "rule",
    "title",
    "category",
    "severity",
    "priority",
    "confidence",
    "evidence_class",
    "file",
    "url",
    "line",
    "evidence",
    "message",
    "fix_hint",
    "refs",
    "scope",
    "as_of"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SG-[0-9a-f]{12}$",
      "description": "SG- + sha1(rule|file|url|evidence_key)[:12]; stable across runs and unrelated edits."
    },
    "rule": {
      "type": "string",
      "pattern": "^[A-Z]{2,6}\\d{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "category": {
      "type": "string",
      "enum": [
        "crawl_index",
        "rendering",
        "metadata",
        "structured_data",
        "discovery",
        "architecture",
        "performance_media",
        "content",
        "ai_access",
        "monitoring",
        "fidelity"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "A official documentation; B deterministic spec/structure check; C heuristic; D experimental (never penalizes a score)."
    },
    "file": {
      "type": [
        "string",
        "null"
      ],
      "description": "POSIX path of the audited file, when known."
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Page or site URL, when known (redacted)."
    },
    "line": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "evidence": {
      "type": "object",
      "description": "Small object of observed/expected values; strings truncated to 200 characters; untrusted data from the audited site."
    },
    "message": {
      "type": "string",
      "maxLength": 300
    },
    "fix_hint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(fact:F-(AI|T)-\\d{2}|rule:[A-Z]{2,6}\\d{3}|(references|templates|skills)/[A-Za-z0-9._/-]+\\.md(#[a-z0-9-]+)?|https://\\S+)$"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected",
        "sample"
      ],
      "properties": {
        "affected": {
          "type": "integer",
          "minimum": 1
        },
        "sample": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Facts as-of date of the catalog that produced the finding."
    }
  }
}
