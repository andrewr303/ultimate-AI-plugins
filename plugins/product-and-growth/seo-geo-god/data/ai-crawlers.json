  "note": "Robots.txt tokens for AI crawlers, user-triggered fetchers, agents and control tokens, seeded from vendor documentation fetched on 2026-11-01. Entries labelled 3P come from third-party sources only and need verification. User-agent strings are claims: verify bots with the published IP lists, reverse DNS or signatures. block_rule is the finding SEO-GEO-god emits when a group blocks the whole site for that token.",
  "recheck_by": [
    "2026-12-15",
    "2027-02-01",
    "2027-03-01",
    "2027-09-30"
  ],
  "labels": {
    "V": "vendor primary source fetched 2026-11-01",
    "S": "standards body primary source",
    "SR": "seen only in search-result snippets (needs verification)",
    "3P": "third-party or secondary source only (needs verification)"
  },
  "classes": {
    "TRAIN": "Collects content for model training or fine-tuning; blocking it affects training use, not search inclusion.",
    "INDEX": "Builds a search or answer index that an AI product cites; blocking it removes or reduces the site there.",
    "USER": "Fetches a page because a person asked an assistant to; some vendors say robots.txt may not apply.",
    "AGENT": "Browser agent that navigates and acts for a person; generally not bound by robots.txt.",
    "ADS": "Reviews ad landing pages.",
    "PREVIEW": "Fetches link previews for shared URLs.",
    "MIXED": "One crawler serves classic search and other products, which can include AI features.",
    "CONTROL": "robots.txt token with no crawler of its own (training controls and legacy names).",
    "CORPUS": "Builds an open web corpus that third parties reuse, including for AI training."
  },
